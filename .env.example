# ChartDeck configuration. Copy to .env for docker compose; every variable is optional.
# Services read these from the environment; defaults are shown.

# ---- shared -------------------------------------------------------------------
# Comma-separated data providers to enable: binance, mock
PROVIDERS=binance
# Redis used for pub/sub between ingest and gateways, the hot-candle cache and demand tracking.
REDIS_URL=redis://localhost:6379
# trace | debug | info | warn | error
LOG_LEVEL=info
# Set to true when running behind a reverse proxy, so client IPs come from X-Forwarded-For.
TRUST_PROXY=false

# ---- binance provider ---------------------------------------------------------
# Override if api.binance.com is unreachable from your network. Market data mirrors:
#   BINANCE_REST_URL=https://data-api.binance.vision
#   BINANCE_WS_URL=wss://data-stream.binance.vision
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443

# ---- ingest -------------------------------------------------------------------
# Minimum ms between candle publishes per symbol; trades in between are coalesced.
# Lower = less latency, more Redis/socket traffic. 0 publishes every trade.
INGEST_FLUSH_MS=25
# Keep streaming a symbol this long after its last viewer leaves (absorbs quick re-subscribes).
INGEST_LINGER_MS=60000
# TTL (s) of the hot-candle snapshot new subscribers are primed with.
HOT_CACHE_TTL_SEC=120
# Port for /healthz, /readyz, /metrics.
INGEST_OPS_PORT=9101

# ---- ws-gateway ---------------------------------------------------------------
GATEWAY_PORT=8080
# Browser origins allowed to open a WebSocket. Use * only for local experiments.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
GATEWAY_MAX_CLIENTS=10000
GATEWAY_MAX_CLIENTS_PER_IP=20
# Max (symbol, timeframe) subscriptions per connection.
GATEWAY_MAX_SUBSCRIPTIONS=50
# Backpressure: above SOFT buffered bytes a client's candle frames are conflated (newest only);
# above HARD, or after MAX_STALL_MS of conflation, the client is disconnected and reconnects.
GATEWAY_SOFT_BUFFER_BYTES=262144
GATEWAY_HARD_BUFFER_BYTES=4194304
GATEWAY_MAX_STALL_MS=10000

# ---- api ----------------------------------------------------------------------
API_PORT=8081
# TimescaleDB for the closed-candle cache. Leave unset to serve history straight from providers.
DATABASE_URL=postgres://chartdeck:chartdeck@localhost:5432/chartdeck
# Requests per minute per client IP.
API_RATE_LIMIT_PER_MIN=300
# HS256 key for access tokens (>= 32 chars). Required when running more than one api replica;
# if unset, a random per-process key is used (clients transparently refresh after a restart).
#   openssl rand -base64 48
JWT_SECRET=
# Origins allowed to call the cookie-authenticated auth endpoints (also used by ws-gateway).
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Force the Secure flag on the refresh cookie. Default: follow the request protocol
# (X-Forwarded-Proto when TRUST_PROXY=true). Set to true in production behind TLS.
COOKIE_SECURE=

# Lets the alerts service fetch history without being rate-limited. Any long random string,
# set to the same value for api and alerts.   openssl rand -hex 32
INTERNAL_TOKEN=

# ---- email (api and alerts) -----------------------------------------------------
# SMTP server for verification, password-reset and alert emails, e.g.
#   smtps://user:password@smtp.example.com:465   or   smtp://localhost:1025 (Mailpit, see compose)
# Unset: emails are written to the log instead, links included. Fine locally, not in production.
SMTP_URL=
MAIL_FROM=ChartDeck <no-reply@chartdeck.local>
# Origin used for links in emails. Default: the first ALLOWED_ORIGINS entry.
PUBLIC_URL=

# ---- alerts ---------------------------------------------------------------------
# Single replica. Reads alerts from DATABASE_URL, streams candles from REDIS_URL, and fetches
# indicator warm-up history from the api.
API_URL=http://localhost:8081
ALERTS_OPS_PORT=9102

# ---- docker compose only ------------------------------------------------------
POSTGRES_PASSWORD=chartdeck
WEB_PORT=3000
