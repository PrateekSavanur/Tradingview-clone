{
  "uid": "chartdeck-overview",
  "title": "ChartDeck \u00b7 Live data pipeline",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "5s",
  "tags": [
    "chartdeck"
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Connected clients",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cd_gateway_clients)"
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Ticks / s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cd_ingest_trades_total[1m]))"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Upstream live",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bool_on_off"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(cd_ingest_upstream_live)"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Upstream reconnects (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(cd_ingest_upstream_reconnects_total[24h]))"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Tick rate by provider",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (rate(cd_ingest_trades_total[1m]))",
          "legendFormat": "{{provider}}"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Exchange \u2192 ingest latency",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(cd_ingest_exchange_to_ingest_ms_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(cd_ingest_exchange_to_ingest_ms_bucket[1m])))",
          "legendFormat": "p99"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Fan-out latency (ingest publish \u2192 socket write)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(cd_gateway_fanout_ms_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(cd_gateway_fanout_ms_bucket[1m])))",
          "legendFormat": "p99"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Ingest coalescing delay",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(cd_ingest_receive_to_publish_ms_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(cd_ingest_receive_to_publish_ms_bucket[1m])))",
          "legendFormat": "p99"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Clients & subscriptions",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cd_gateway_clients)",
          "legendFormat": "clients"
        },
        {
          "refId": "B",
          "expr": "sum(cd_gateway_subscriptions)",
          "legendFormat": "subscriptions"
        },
        {
          "refId": "C",
          "expr": "sum(cd_ingest_symbols)",
          "legendFormat": "symbols streamed"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Frames / s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cd_gateway_frames_sent_total[1m]))",
          "legendFormat": "sent"
        },
        {
          "refId": "B",
          "expr": "sum(rate(cd_gateway_frames_conflated_total[1m]))",
          "legendFormat": "conflated (backpressure)"
        },
        {
          "refId": "C",
          "expr": "sum(rate(cd_gateway_slow_consumer_disconnects_total[5m]))*60",
          "legendFormat": "slow-consumer drops / min"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Upstream reconnects",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (increase(cd_ingest_upstream_reconnects_total[5m]))",
          "legendFormat": "{{provider}}"
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Event loop lag (p99)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (service) (nodejs_eventloop_lag_p99_seconds)",
          "legendFormat": "{{service}}"
        }
      ],
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Rejected connections / messages",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(cd_gateway_rejected_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "Exchange clock offset",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cd_ingest_exchange_clock_offset_ms",
          "legendFormat": "{{provider}}"
        }
      ],
      "id": 14
    }
  ]
}
